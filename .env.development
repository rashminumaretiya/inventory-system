# Read by `npm start` only; production builds ignore this file.

# Listen on this computer only. Create React App otherwise binds to every
# network interface, so anyone on the same Wi-Fi could reach the dev server.
HOST=localhost

# To open the app from a phone on the same Wi-Fi, override it for one run,
# on a network you trust:
#   HOST=0.0.0.0 npm start
